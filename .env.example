# Copy to .env.local and fill in. Never commit real values.

YOUTUBE_API_KEY=

# Cloudflare R2 (S3-compatible API credentials, not the Cloudflare API token)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Gallery admin at /admin/gallery
ADMIN_PASSWORD=
# Random string, at least 32 characters (e.g. `openssl rand -base64 48`)
ADMIN_SESSION_SECRET=
